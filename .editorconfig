root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props}]
indent_size = 2

[*.{js,css,html}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Міграції EF Core генерує інструмент, аналізатори їх не перевіряють.
[**/Migrations/**.cs]
generated_code = true
